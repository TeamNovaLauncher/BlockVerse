rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isCreator() {
      return signedIn()
        && exists(/databases/$(database)/documents/system/owner)
        && get(/databases/$(database)/documents/system/owner).data.uid == request.auth.uid;
    }
    function dailyRewardUpdate() {
      let oldLast = resource.data.get('lastDailyClaimAt', null);
      let oldStreak = resource.data.get('dailyStreak', 0);
      let newStreak = oldLast == null || oldLast < request.time - duration.value(48, 'h') ? 1 : oldStreak + 1;
      let reward = 20 + (newStreak - 1) * 40;
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['coins', 'dailyStreak', 'lastDailyClaimAt'])
        && (oldLast == null || oldLast < request.time - duration.value(24, 'h'))
        && request.resource.data.dailyStreak == newStreak
        && request.resource.data.coins == resource.data.get('coins', 0) + reward
        && request.resource.data.lastDailyClaimAt == request.time;
    }
    match /system/owner {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && !exists(/databases/$(database)/documents/system/owner);
      allow update, delete: if false;
    }
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isCreator());
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == uid
        && (request.resource.data.role == 'player'
          || (request.resource.data.role == 'creator'
            && getAfter(/databases/$(database)/documents/system/owner).data.uid == uid));
      allow update: if signedIn() && (
        (request.auth.uid == uid
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.email == resource.data.email
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['username']))
        || (request.auth.uid == uid && dailyRewardUpdate())
        || (isCreator()
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.email == resource.data.email
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['coins']))
      );
      allow delete: if isCreator() && uid != request.auth.uid;
    }
    match /games/{gameId} {
      allow read: if true;
      allow create, update, delete: if isCreator();
    }
    match /platform/{docId} {
      allow read: if signedIn();
      allow create, update, delete: if isCreator();
    }
  }
}